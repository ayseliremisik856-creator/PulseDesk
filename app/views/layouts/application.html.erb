<!DOCTYPE html>
<html lang="tr">
  <head>
    <title>PulseDesk · Müşteri desteği</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="topbar">
      <%= link_to root_path, class: "logo" do %><span class="logo-mark">p/</span> PulseDesk<% end %>
      <nav><%= link_to "Genel bakış", root_path %><%= link_to "+ Yeni talep", new_ticket_path, class: "button" %></nav>
    </header>
    <main class="container">
      <% flash.each do |kind, message| %><div role="status" class="flash <%= kind %>"><%= message %></div><% end %>
      <%= yield %>
    </main>
    <footer>PulseDesk · Her talep, zamanında bir yanıt.</footer>
  </body>
</html>
